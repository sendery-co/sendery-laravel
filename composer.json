{
  "name": "sendery/laravel",
  "description": "Sendery laravel template email SDK",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "sendery/php": "^0.1.4",
    "sendery/symfony": "^0.1.4",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/mail": "^13.0",
    "illuminate/notifications": "^13.0",
    "illuminate/auth": "^13.0",
    "illuminate/bus": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Sendery\\Laravel\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "orchestra/testbench": "^11.0"
  },
  "scripts": {
    "test": "phpunit --bootstrap vendor/autoload.php tests"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Sendery\\Laravel\\SenderyServiceProvider"
      ]
    }
  },
  "support": {
    "source": "https://github.com/sendery-co/sendery-laravel",
    "issues": "https://github.com/sendery-co/sendery-laravel/issues"
  }
}
